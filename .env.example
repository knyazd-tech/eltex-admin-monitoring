# Eltex device web interface.
ELTEX_BASE_URL=http://eltex-device.example

# Base64 encodes values; it does not encrypt them.
# printf '%s' 'username' | base64 -w0
ELTEX_USERNAME_B64=REPLACE_WITH_BASE64_USERNAME
ELTEX_PASSWORD_B64=REPLACE_WITH_BASE64_PASSWORD

# Use 0.0.0.0 inside a container.
# Prefer a dedicated management address with systemd.
ELTEX_LISTEN_ADDRESS=127.0.0.1
ELTEX_LISTEN_PORT=9824

ELTEX_FAST_INTERVAL=30
ELTEX_LEGACY_INTERVAL=60
ELTEX_REQUEST_TIMEOUT=20
